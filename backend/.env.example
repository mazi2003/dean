# Environment variables — copy to .env and fill in values
# NEVER commit .env to source control

# Database
DATABASE_URL="postgresql://deanoffice:changeme@localhost:5432/deanoffice?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# Cookie signing
COOKIE_SECRET="change-this-to-another-long-random-secret"

# CORS — set to your frontend origin
CORS_ORIGIN="http://localhost:5173"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# AI assistant (optional — omit to disable)
# AI_API_KEY=your-gemini-api-key-here
