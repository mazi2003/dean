# Environment variables — copy to .env and fill in values
# NEVER commit .env to source control

# Database
DATABASE_URL="postgresql://dean:CHANGE_ME_DB_PASSWORD@localhost:5432/dean?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# Cookie signing
COOKIE_SECRET="change-this-to-another-long-random-secret"
# Set true in production over HTTPS
COOKIE_SECURE=false
TRUST_PROXY=true

# CORS — set to your frontend origin
CORS_ORIGIN="http://localhost:5173"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Optional OpenAI-compatible AI assistant (server-side only; rules fallback works without key)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
