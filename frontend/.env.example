# Frontend Environment Variables Template
# Copy to .env.local for custom API routing during local development.
# NEVER commit .env or .env.local to version control.

# Base URL for backend REST API (defaults to /api/v1 via Vite proxy or reverse proxy)
# Also supports legacy VITE_API_BASE_URL as a fallback if VITE_API_URL is unset.
VITE_API_URL=/api/v1
