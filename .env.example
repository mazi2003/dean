# Root Docker Compose Environment Template
# Copy to .env and replace all CHANGE_ME placeholders before deployment.
DOMAIN=localhost
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://dean:CHANGE_ME_DB_PASSWORD@db:5432/dean?schema=public
JWT_SECRET=CHANGE_ME_LONG_RANDOM_MIN_32_CHARS
COOKIE_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
COOKIE_SECURE=true
TRUST_PROXY=true
CORS_ORIGIN=https://your-domain.example
SEED_STUDENT_PASSWORD=CHANGE_ME_STUDENT_PASS
SEED_STAFF_PASSWORD=CHANGE_ME_STAFF_PASS

# Optional OpenAI-compatible AI assistant (server-side only; rules fallback works without key)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
